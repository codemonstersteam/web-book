#!/bin/bash

export PATH="/Users/mac/Library/Python/3.9/bin:$PATH"

echo "→ Проверка сборки mkdocs..."

output=$(mkdocs build 2>&1)
exit_code=$?

if [ $exit_code -ne 0 ]; then
  echo "$output" | grep -E "ERROR|Aborted"
  echo "✗ mkdocs build завершился с ошибкой. Коммит отменён."
  exit 1
fi

echo "✓ mkdocs build успешен."
exit 0
